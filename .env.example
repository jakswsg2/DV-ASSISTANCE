# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration Foundation (Step 10)
PORT=3000
NODE_ENV="development"
MAX_JSON_BODY_SIZE="100kb"

# Database Persistence Architecture (Step 11)
# Cloud SQL PostgreSQL runtime connection variables:
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="dv_assistance"
SQL_USER="dv_app_user"
SQL_PASSWORD="YOUR_SQL_PASSWORD_HERE"

# Schema management & Drizzle Kit admin credentials:
SQL_ADMIN_USER="dv_admin_user"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD_HERE"

# Standard PostgreSQL connection URL (optional local fallback):
# DATABASE_URL="postgresql://user:password@localhost:5432/dv_assistance"

# Production Identity, Sessions & Audit Engine (Step 12)
# Server-side Session Management:
SESSION_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_IN_PRODUCTION"
SESSION_TTL_SECONDS="28800"

# Server-only Firebase Admin SDK Credentials (NEVER expose to client bundle):
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Client-side Safe Public Firebase SDK Configuration (Vite client-only):
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"



