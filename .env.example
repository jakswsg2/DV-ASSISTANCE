# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration Foundation (Step 10)
PORT=3000
NODE_ENV="development"
MAX_JSON_BODY_SIZE="100kb"

# Database Persistence Architecture (Step 11)
# Cloud SQL PostgreSQL runtime connection variables:
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="dv_assistance"
SQL_USER="dv_app_user"
SQL_PASSWORD="YOUR_SQL_PASSWORD_HERE"

# Schema management & Drizzle Kit admin credentials:
SQL_ADMIN_USER="dv_admin_user"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD_HERE"

# Standard PostgreSQL connection URL (optional local fallback):
# DATABASE_URL="postgresql://user:password@localhost:5432/dv_assistance"

# Production Identity, Sessions & Audit Engine (Step 12)
# Server-side Session Management:
SESSION_SECRET=dev-local-session-secret-7f4c9a21e8b63d5a
SESSION_TTL_SECONDS="28800"

# Development-only auth gate (POST /api/v1/auth/dev-session).
# Secure by default: leave unset or false. Requires NODE_ENV=development as well.
# NEVER set to true in production or on a publicly reachable domain.
ALLOW_DEV_AUTH="false"

# Server-only Firebase Admin SDK Credentials (NEVER expose to client bundle):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client-side Safe Public Firebase SDK Configuration (Vite client-only):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET="
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=



